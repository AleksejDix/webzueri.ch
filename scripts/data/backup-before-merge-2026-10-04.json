    {
      "id": "cl0gtyp5h2k5b0cxl5i59y93s",
      "name": "Web Development Fallacies",
      "abstract": "According to the Cambridge Dictionary, a fallacy is: \"an idea that a lot of people think is true but is in fact false.\"",
      "youtubecode": null,
      "slides": null,
      "category": "Frontend",
