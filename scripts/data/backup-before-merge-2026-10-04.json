    {
      "id": "cjjn84t0481n30953jk7cjj4t",
      "name": "HTTP Caching",
      "abstract": "In this introduction, David took us to explore HTTP and we looked at how a web server can control what may be cached.",
      "youtubecode": null,
      "slides": null,
      "category": "Frontend",
      "createdAt": "2018-07-15T19:19:25.4+00:00",
      "event": null,
      "speakers": [
